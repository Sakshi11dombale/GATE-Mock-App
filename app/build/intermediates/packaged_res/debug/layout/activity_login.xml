<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/app_bg" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:padding="30dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GATE" android:textColor="#4A42AA" android:textSize="42sp" android:textStyle="bold" android:layout_marginTop="34dp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Prep Studio" android:textColor="#263247" android:textSize="21sp" android:textStyle="bold" android:layout_marginTop="-6dp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Practice smarter. Track progress. Crack GATE." android:textColor="#6F7D91" android:textSize="10sp" android:layout_marginTop="5dp" android:layout_marginBottom="32dp"/>
<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="22dp" app:cardElevation="1dp" app:strokeWidth="1dp" app:strokeColor="#E2E6EF" app:cardBackgroundColor="#FFFFFF"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Welcome back" android:textColor="#263247" android:textSize="17sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Continue your preparation" android:textColor="#6F7D91" android:textSize="11sp" android:layout_marginTop="4dp" android:layout_marginBottom="16dp"/><TextView android:id="@+id/tv_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#A24D4A" android:textSize="12sp" android:background="@drawable/bg_error_box" android:padding="10dp" android:visibility="gone"/>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Username" android:layout_marginBottom="10dp" app:boxCornerRadiusTopStart="8dp" app:boxCornerRadiusTopEnd="8dp" app:boxCornerRadiusBottomStart="8dp" app:boxCornerRadiusBottomEnd="8dp"><com.google.android.material.textfield.TextInputEditText android:id="@+id/et_username" android:layout_width="match_parent" android:layout_height="54dp" android:inputType="text"/></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Password" app:endIconMode="password_toggle" android:layout_marginBottom="16dp" app:boxCornerRadiusTopStart="8dp" app:boxCornerRadiusTopEnd="8dp" app:boxCornerRadiusBottomStart="8dp" app:boxCornerRadiusBottomEnd="8dp"><com.google.android.material.textfield.TextInputEditText android:id="@+id/et_password" android:layout_width="match_parent" android:layout_height="54dp" android:inputType="textPassword"/></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.button.MaterialButton android:id="@+id/btn_login" android:layout_width="match_parent" android:layout_height="52dp" android:text="Login" android:textAllCaps="false" android:textStyle="bold" android:textColor="#FFFFFF" app:backgroundTint="#4B3DB4" app:cornerRadius="8dp"/><ProgressBar android:id="@+id/progress_bar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:visibility="gone"/></LinearLayout></com.google.android.material.card.MaterialCardView>
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="20dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="New to GATE Prep Studio? " android:textColor="#6F7D91" android:textSize="12sp"/><TextView android:id="@+id/tv_register" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Create account" android:textColor="#4B3DB4" android:textSize="12sp" android:textStyle="bold"/></LinearLayout></LinearLayout></ScrollView>